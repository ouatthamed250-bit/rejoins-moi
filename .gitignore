# ── Dépendances ──────────────────────────────────────────────────────────────
node_modules/

# ── Secrets : NE JAMAIS pousser ces fichiers ─────────────────────────────────
# backend/.env contient le mot de passe MongoDB Atlas et le secret JWT.
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ── Builds et caches ─────────────────────────────────────────────────────────
dist/
build/
.vite/
.cache/

# ── Déploiement ──────────────────────────────────────────────────────────────
.vercel/
.netlify/

# ── Données locales de développement ─────────────────────────────────────────
# backend/data/ ne contient pas du code : c'est le jeu de données brut que l'on
# importe (etablissements_seed.json, ~4,5 Mo) et que l'on régénère à la demande.
# Le script d'import accepte un autre chemin avec `--fichier=...` :
#   node backend/scripts/importer-etablissements.js --fichier=mon-fichier.json
backend/data/

# ── Preuves de recette (captures et rapports) ────────────────────────────────
# Les scripts de capture écrivent leurs PNG et leur _rapport.json dans le dossier passé
# en argument (ex. : node frontend/scripts/capture-admin.mjs captures-admin-production).
# Ce sont des preuves visuelles, pas du code : elles ne sont PAS versionnées.
captures-refonte/
frontend/captures-admin-en-ligne/
frontend/captures-admin-production/
# Rapports de mesure du démarrage (froid/chaud) et du poids des listes : rejouables
# avec `npm run verifier:demarrage` et `npm run verifier:poids-listes`, donc non
# versionnés pour ne pas alourdir le dépôt.
captures-demarrage/
# Preuves de l'autorisation de localisation (bloc B) : captures d'écran du parcours
# réel et _rapport.json, tous deux régénérables par `npm run verifier:permissions`.
captures-permissions/
# ── Divers ───────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.log

# Preuves du parcours � nouveau venu � (bloc E) : captures d'ecran et rapport regenerables.
captures-parcours/

