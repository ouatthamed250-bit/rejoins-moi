# ── Dépendances ──────────────────────────────────────────────────────────────
node_modules/

# ── Secrets : NE JAMAIS pousser ces fichiers ─────────────────────────────────
# backend/.env contient le mot de passe MongoDB Atlas et le secret JWT.
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ── Sauvegardes chiffrées de la base ─────────────────────────────────────────
# `npm run sauvegarder:base` écrit ici des archives de la base de PRODUCTION
# (données personnelles des artisans). Même chiffrées, elles ne doivent JAMAIS
# être versionnées ni poussées sur GitHub. Procédure : docs/SAUVEGARDE.md
backups/

# ── Builds et caches ─────────────────────────────────────────────────────────
dist/
build/
.vite/
.cache/

# ── Déploiement ──────────────────────────────────────────────────────────────
.vercel/
.netlify/

# ── Données locales de développement ─────────────────────────────────────────
# backend/data/ ne contient pas du code : c'est le jeu de données brut que l'on
# importe (etablissements_seed.json, ~4,5 Mo) et que l'on régénère à la demande.
# Le script d'import accepte un autre chemin avec `--fichier=...` :
#   node backend/scripts/importer-etablissements.js --fichier=mon-fichier.json
backend/data/

# ── Preuves de recette (captures et rapports) ────────────────────────────────
# Les scripts de capture écrivent leurs PNG et leur _rapport.json dans le dossier passé
# en argument (ex. : node frontend/scripts/capture-admin.mjs captures-admin-production).
# Ce sont des preuves visuelles, pas du code : elles ne sont PAS versionnées.
captures-refonte/
frontend/captures-admin-en-ligne/
frontend/captures-admin-production/
# Rapports de mesure du démarrage (froid/chaud) et du poids des listes : rejouables
# avec `npm run verifier:demarrage` et `npm run verifier:poids-listes`, donc non
# versionnés pour ne pas alourdir le dépôt.
captures-demarrage/
# Preuves de l'autorisation de localisation (bloc B) : captures d'écran du parcours
# réel et _rapport.json, tous deux régénérables par `npm run verifier:permissions`.
captures-permissions/
# ── Sorties brutes de scripts (journaux) ─────────────────────────────────────
# Redirections `> sortie.out` / `2> erreurs.err` écrites à côté de l'outil qui
# les produit (ex. `backend/sauvegarde-run.out` après `npm run sauvegarder:base`,
# `frontend/perm.out` après une recette). Régénérables, jamais du code : sans ces
# motifs ils réapparaissent en « fichiers non suivis » à chaque `git status`,
# et un `git add .` les pousserait sur GitHub.
*.out
*.err
*.pid

# ── Dossiers de vérification visuelle ponctuels ──────────────────────────────
# Captures et rapports produits par les scripts de recette dans un dossier jetable
# (`frontend/_verif-medaillon/`, `frontend/_verif-visites/`…). Ce sont des preuves
# visuelles de quelques mégaoctets, pas du code, et elles se régénèrent.
frontend/_verif-*/

# ── Divers ───────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.log

# Preuves du parcours « nouveau venu » (bloc E) : captures d'écran et rapport régénérables.
captures-parcours/

# Preuves de la signature graphique dessinée au crayon : planche de recette des
# illustrations, captures avant/après des écrans et relevés de poids du paquet.
# Tous régénérables : ce sont des preuves visuelles, pas du code.
frontend/captures-signature/

# Preuves du correctif des barres basses (bloc B) : captures, rapports et journaux
# avant/apres, tous regenerables par `npm run verifier:barres`.
frontend/captures-barres/
# Journaux de console des recettes (perm.out, barres.err, *.pid) : sorties brutes
# ecrites a cote des scripts, regenerables et sans interet pour le depot.
frontend/*.out
frontend/*.err
frontend/*.pid

# Vérifications du site PUBLIÉ (GitHub Pages) : captures d'écran de l'accueil et de
# la recherche prises sur le domaine public, régénérables en rejouant le contrôle.
frontend/captures-en-ligne/

