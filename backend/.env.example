# ─────────────────────────────────────────────────────────────
# Rejoins'Moi — Backend (Node.js + Express + MongoDB)
# Copier ce fichier en `.env` puis compléter les valeurs.
# ─────────────────────────────────────────────────────────────

# Serveur
PORT=4000
NODE_ENV=development

# Base de données MongoDB
#  - Atlas (gratuit, recommandé : aucune installation locale) :
#      MONGODB_URI=mongodb+srv://<utilisateur>:<motdepasse>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#      (si le mot de passe contient @ # / : ?, encodez-le : @ -> %40)
#      Le nom de base est imposé plus bas par MONGODB_DB_NAME.
#  - MongoDB local (développement) :
#      MONGODB_URI=mongodb://127.0.0.1:27017/rejoins-moi
MONGODB_URI=mongodb://127.0.0.1:27017/rejoins-moi
# Nom de la base (forcé : évite la base « test » créée par défaut avec une URI Atlas).
MONGODB_DB_NAME=rejoins-moi
# Délai de sélection du serveur (ms) : monter à 15000 sur un réseau lent.
MONGODB_TIMEOUT_MS=8000

# Secret de signature des JWT — À CHANGER ABSOLUMENT en production
JWT_SECRET=change-moi-en-production-secret-long-et-aleatoire
JWT_EXPIRES_IN=30d

# Origines autorisées (frontend web + futur PWA / app mobile)
CLIENT_URL=http://localhost:5173

# ─── Paiement mobile money (voir docs/cahier-des-charges.md §2) ───
# CinetPay agrège Wave, Orange Money, MTN MoMo et Moov Money.
# Créer un compte marchand sur https://cinetpay.com puis renseigner :
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# URL publique appelée par CinetPay pour confirmer la transaction (webhook).
# En local, utilisez un tunnel (ngrok / cloudflared) : https://xxxx.ngrok.io/api/jobs/webhook/cinetpay
CINETPAY_NOTIFY_URL=
# URL de retour dans l'app après paiement
CINETPAY_RETURN_URL=http://localhost:5173/main-doeuvre
# Chaîne de canaux à proposer (tous mobile money disponibles)
CINETPAY_CHANNELS=WAVE,ORANGE_MONEY,MTN_MOMO,MOOV_MONEY
# Mode test de la passerelle : laisser vide en production
CINETPAY_SANDBOX=true

# Montant du déblocage de contact main-d'œuvre (cahier des charges §2)
CONTACT_UNLOCK_FEE=500
CURRENCY=XOF

# ─── Abonnement (cahier des charges, ajout du 29/09) ───
# ⚠️ PRIX NON TRANCHÉS : les valeurs par défaut sont PROVISOIRES et servent à tester
# le parcours de souscription. DEUX FORMULES sont vendues en parallèle (semaine + mois)
# pour décider sur le terrain laquelle les artisans préfèrent.
# Référence : backend/src/config/abonnement.js (ces variables ne font que la surcharger,
# ce qui permet de changer un tarif sans redéployer le code si l'hébergeur le permet).
#
# Liste des formules réellement proposées (LISTE CSV, pas une valeur unique) :
#   SUBSCRIPTION_PERIODICITY=hebdomadaire,mensuel   # les deux (défaut)
#   SUBSCRIPTION_PERIODICITY=mensuel               # une seule, pour figer un choix
# SUBSCRIPTION_FORMULA_DEFAULT=artisan_hebdo       # formule présélectionnée (idem UI)
# Tarifs et durées (FCFA / jours) :
#   SUBSCRIPTION_PRICE_WEEKLY_FCFA=700
#   SUBSCRIPTION_DURATION_WEEKLY_DAYS=7
#   SUBSCRIPTION_PRICE_MONTHLY_FCFA=2500
#   SUBSCRIPTION_DURATION_MONTHLY_DAYS=30
