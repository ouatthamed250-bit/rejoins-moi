# ─────────────────────────────────────────────────────────────
# Rejoins'Moi — Frontend (React + Vite)
# Copier ce fichier en `.env` puis compléter si nécessaire.
# ─────────────────────────────────────────────────────────────

# URL de l'API.
#  - Laisser VIDE en développement : le proxy Vite (vite.config.js) redirige
#    automatiquement /api vers http://localhost:4000.
#  - En production, indiquer l'URL publique du backend, ex. https://api.rejoinsmoi.ci
VITE_API_URL=

# Cible du proxy Vite en développement (backend Express local)
VITE_PROXY_TARGET=http://localhost:4000

# Montant du déblocage de contact main-d'œuvre (cahier des charges §2)
VITE_CONTACT_UNLOCK_FEE=500
VITE_CURRENCY=XOF

# Nom affiché de l'application
VITE_APP_NAME=Rejoins'Moi

# Centre de carte par défaut : Plateau, Abidjan
VITE_DEFAULT_LAT=5.3242
VITE_DEFAULT_LNG=-4.0206
